# Database
# Neon Free (recommended for phone + laptop + many users): paste the pooled URI from
# https://console.neon.tech  →  Connect  →  copy "Connection string"
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
#
# Laptop-only fallback (accounts stay on this PC and can break if the file locks):
DATABASE_URL=pglite:./.data/ul-pglite

# ---- AI provider ----
# auto     = Cerebras → Groq → Gemini → offline knowledge (recommended)
# cerebras = fastest free cloud (gpt-oss-120b, ~3000 tok/s)
# groq     = very fast free cloud (Llama 3.3 70B)
# local    = instant offline answers from the UL knowledge base
AI_PROVIDER=auto

# Recommended: free Cerebras key — https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

# Optional fallback — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional only
GEMINI_API_KEY=

PORT=8080

{
  "framework": null,
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @workspace/ul-ai-assistant run build && pnpm --filter @workspace/api-server run build:vercel",
  "outputDirectory": "artifacts/ul-ai-assistant/dist/public",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 10,
      "includeFiles": "{artifacts/api-server/dist/vercel-handler.mjs,artifacts/api-server/data/**}"
    }
  }
}
